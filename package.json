{
  "name": "iqrafi",
  "version": "0.1.0",
  "private": true,
  "description": "IQRAFI — Read. Complete. Together.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "quran:build": "tsx scripts/quran/build-dataset.ts",
    "quran:validate": "tsx scripts/quran/validate-dataset.ts",
    "db:seed:quran": "tsx scripts/seed-quran.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:setup": "npm run db:migrate && npm run db:seed:quran",
    "stats:refresh": "tsx scripts/refresh-stats.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "check": "npm run lint && npm run typecheck && npm run quran:validate && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "quran-json": "^3.1.2",
    "quran-meta": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
