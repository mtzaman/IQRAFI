# Copy to .env.local (Next.js) and .env (scripts). Never commit real secrets.

# PostgreSQL connection (local Postgres or Supabase "Session pooler" connection string)
DATABASE_URL=postgresql://iqrafi:iqrafi@localhost:5432/iqrafi
# Used only by the integration test suite. It is wiped between test runs.
TEST_DATABASE_URL=postgresql://iqrafi:iqrafi@localhost:5432/iqrafi_test

# Public origin of the app, used for invitation links and OAuth callbacks
APP_URL=http://localhost:3000

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Sign in with Apple (architecture ready; requires an Apple Developer account)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 private key contents, with literal \n for newlines
APPLE_PRIVATE_KEY=


# Secret required by the scheduled statistics job endpoint (POST /api/cron/stats)
CRON_SECRET=
